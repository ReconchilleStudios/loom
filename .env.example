# Loom's keys. Do not copy this file by hand: run `bash tools/keys/open.sh`,
# which asks for each key in its own window, checks it for free and writes
# .env with mode 600. These are the names it writes.

# ElevenLabs · the voice, the score, the sound effects, the word timings · required
ELEVENLABS_API_KEY=

# fal.ai · generated stills and image-to-video · recommended
FAL_KEY=

# Pexels · free stock footage · recommended
PEXELS_API_KEY=
